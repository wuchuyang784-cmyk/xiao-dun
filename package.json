{
  "name": "xiaodun-anti-fraud-agent",
  "productName": "Xiao Dun Admin Web",
  "version": "0.1.0",
  "private": true,
  "description": "Local anti-fraud autonomous planning agent with LLM, memory system, and risk assessment tools",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start-web.mjs",
    "start:web": "node scripts/start-web.mjs",
    "start:backend": "node --env-file-if-exists=.env src/index.js",
    "dev": "node scripts/start-web.mjs",
    "rag:db:up": "docker compose -f rag-service/compose.yml up -d postgres",
    "rag:db:seed": "type rag-service\\ai-engine\\migrations\\seed_risk_map_demo.sql | docker exec -i rag-service-postgres-1 psql -U xiaodun -d xiaodun",
    "rag:db:down": "docker compose -f rag-service/compose.yml down postgres",
    "test": "node --test test/*.test.js",
    "lint": "node --check scripts/web-runtime.mjs && node --check scripts/start-web.mjs && node --check src/ui/brain-ui/app.js",
    "smoke:brain-ui": "node scripts/smoke-brain-ui.mjs",
    "build": "npm run lint && npm run format:check && npm run typecheck",
    "format:check": "node scripts/check-format.mjs",
    "typecheck": "node scripts/check-types.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "better-sqlite3": "^12.8.0",
    "echarts": "^5.6.0",
    "openai": "^6.34.0",
    "sherpa-onnx-node": "^1.13.3",
    "undici": "^6.25.0",
    "wechat-ilink-client": "^0.1.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "playwright": "^1.59.1",
    "typescript": "^7.0.2"
  }
}
