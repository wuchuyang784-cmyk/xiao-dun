[project]
sub_id = "287bf5ff"
name = "xiao-dun"
requires = ["nodejs-24"]
project_type = "web"
version = "0.0.32"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "xiao-dun/scripts/coze-preview-build.sh"]
run = ["bash", "xiao-dun/scripts/coze-preview-run.sh"]

[deploy.profile]
kind = "service"
flavor = "web"

[deploy]
build = ["bash", "xiao-dun/scripts/deploy_build.sh"]
run = ["bash", "xiao-dun/scripts/deploy_run.sh"]

[subprojects]
path = ["xiao-dun"]
